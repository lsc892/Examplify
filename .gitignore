node_modules/
*.log

# 작업공간: 폴더 구조(.gitkeep)만 남기고 내용은 제외 (둘 다 데이터)
# desk = 사용자 입출력(intake·output), artifacts = 중간 산출물(build·analyze)
desk/intake/*
!desk/intake/.gitkeep

desk/output/*
!desk/output/.gitkeep

artifacts/build/*
!artifacts/build/.gitkeep

artifacts/analyze/*
!artifacts/analyze/.gitkeep
